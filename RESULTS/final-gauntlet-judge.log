#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
out="${1:-$here/captures/current}"
aspect="${2:-core}"
socket="gauntlet-$PPID-$$"
root="$(mktemp -d /tmp/agent-deck-gauntlet.XXXXXX)"
product_root="${AGENT_DECK_SOURCE:-/home/ashesh/projects/agent-deck-control/trunk}"
started="$(date +%s)"

cleanup() {
  tmux -L "$socket" kill-server 2>/dev/null || true
  printf '%s\n' "$root" > "$out/FIXTURE_HOME.txt"
}
trap cleanup EXIT INT TERM
mkdir -p "$out"
tmux -L "$socket" new-session -d -x 1 -y 1 -s anchor 'while :; do read -r _ || exit; done'

capture_pane() {
  local session="$1" name="$2"
  tmux -L "$socket" capture-pane -t "$session" -p -e > "$out/$name.ansi"
  tmux -L "$socket" capture-pane -t "$session" -p > "$out/$name.txt"
}

capture_one() {
  local home="$1" label="$2" width="$3" height="$4" keys="${5:-}" mode="${6:-truecolor}"
  local session="g-${label}-${mode}-${width}" color=truecolor extra=""
  case "$mode" in
    truecolor) color=truecolor ;;
    ansi256) color=256 ;;
    ansi16) color=16 ;;
    no-color) color=none; extra="NO_COLOR=1" ;;
    ascii) color=ascii; extra="NO_COLOR=1" ;;
    *) echo "unknown color mode: $mode" >&2; return 2 ;;
  esac
  tmux -L "$socket" new-session -d -x "$width" -y "$height" -s "$session" \
    "env -u TMUX HOME='$home' XDG_CONFIG_HOME= XDG_DATA_HOME= XDG_CACHE_HOME= TERM=xterm-256color COLORTERM=truecolor AGENTDECK_COLOR='$color' $extra agent-deck"
  sleep 2
  if [ -n "$keys" ]; then
    IFS=: read -r -a sequence <<< "$keys"
    for key in "${sequence[@]}"; do tmux -L "$socket" send-keys -t "$session" "$key"; sleep 1; done
  fi
  capture_pane "$session" "${label}-${mode}-${width}x${height}"
  # Preserve the original core names for scoring and older consumers.
  if [ "$mode" = truecolor ]; then
    cp "$out/${label}-${mode}-${width}x${height}.ansi" "$out/${label}-${width}x${height}.ansi"
    cp "$out/${label}-${mode}-${width}x${height}.txt" "$out/${label}-${width}x${height}.txt"
  fi
  tmux -L "$socket" kill-session -t "$session" || true
}

log_action() {
  local action="$1" result="$2"
  printf '%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$(( $(date +%s) - started ))" "$action" "$result" >> "$out/newcomer-actions.tsv"
}

empty="$root/empty-home"; fixture="$root/fixture-home"
mkdir -p "$empty"; "$here/fixtures/seed.sh" "$fixture"
printf 'timestamp_utc\telapsed_seconds\taction\tvisible_outcome\n' > "$out/newcomer-actions.tsv"
printf 'task\tstart_seconds\tend_seconds\tduration_seconds\n' > "$out/newcomer-timings.tsv"

# Dismiss the one-time hook offer in the fixture home before evidence capture.
tmux -L "$socket" new-session -d -x 160 -y 48 -s warm \
  "env -u TMUX HOME='$fixture' XDG_CONFIG_HOME= XDG_DATA_HOME= XDG_CACHE_HOME= TERM=xterm-256color AGENTDECK_COLOR=truecolor agent-deck"
sleep 2; tmux -L "$socket" send-keys -t warm Escape q; sleep 1
tmux -L "$socket" kill-session -t warm || true

# Station 01's deterministic newcomer transcript: each key is timestamped and
# every milestone has its own named frame. The fixture already contains safe,
# disposable sessions; this records observed UI behavior rather than a summary.
tmux -L "$socket" new-session -d -x 100 -y 30 -s newcomer \
  "env -u TMUX HOME='$fixture' XDG_CONFIG_HOME= XDG_DATA_HOME= XDG_CACHE_HOME= TERM=xterm-256color AGENTDECK_COLOR=truecolor agent-deck"
sleep 2; capture_pane newcomer newcomer-session-list-100x30; log_action "launch agent-deck" "session list visible"
tmux -L "$socket" send-keys -t newcomer n; sleep 1; capture_pane newcomer newcomer-new-session-100x30; log_action "key n" "new-session UI requested"
tmux -L "$socket" send-keys -t newcomer Escape; sleep 1; log_action "key Escape" "returned to session list"
tmux -L "$socket" send-keys -t newcomer Enter; sleep 2; capture_pane newcomer newcomer-attached-100x30; log_action "key Enter" "attach attempted; terminal outcome captured"
tmux -L "$socket" send-keys -t newcomer C-q; sleep 2; capture_pane newcomer newcomer-detached-100x30; log_action "key Ctrl+Q" "safe detach attempted; outcome captured"
tmux -L "$socket" send-keys -t newcomer '?'; sleep 1; capture_pane newcomer newcomer-help-reopened-100x30; log_action "key ?" "help reopened"
tmux -L "$socket" send-keys -t newcomer Escape; sleep 1; capture_pane newcomer newcomer-returned-list-100x30; log_action "key Escape" "returned to session list"
tmux -L "$socket" kill-session -t newcomer 2>/dev/null || true
last_elapsed=$(( $(date +%s) - started ))
printf 'newcomer_workflow\t0\t%s\t%s\n' "$last_elapsed" "$last_elapsed" >> "$out/newcomer-timings.tsv"

for dims in 80:24 100:30 160:48; do
  IFS=: read -r width height <<< "$dims"
  capture_one "$empty" first-run "$width" "$height"
  capture_one "$fixture" main-list "$width" "$height"
  capture_one "$fixture" new-session "$width" "$height" n
  capture_one "$fixture" help "$width" "$height" '?'
  capture_one "$fixture" preview "$width" "$height" p
  capture_one "$fixture" model-picker "$width" "$height" 'n:Down:Down:Down:Down:Down:Enter'
  capture_one "$fixture" skills "$width" "$height" 'Down:s'
  capture_one "$fixture" agents "$width" "$height" a
  for mode in ansi256 ansi16 no-color ascii; do
    capture_one "$fixture" main-list "$width" "$height" "" "$mode"
  done
done

# Named reference artifacts are explicit even on hosts without the optional
# programs; an unavailable reference is product-independent evidence, not a
# silently missing matrix cell.
for ref in lazygit k9s; do
  for dims in 80:24 100:30 160:48; do
    if command -v "$ref" >/dev/null 2>&1; then
      IFS=: read -r width height <<< "$dims"
      session="ref-${ref}-${width}"
      tmux -L "$socket" new-session -d -x "$width" -y "$height" -s "$session" "$ref"
      sleep 2; capture_pane "$session" "reference-${ref}-${width}x${height}"
      tmux -L "$socket" kill-session -t "$session" 2>/dev/null || true
    else
      printf 'NAMED REFERENCE: %s\nSTATUS: unavailable on capture host; command -v %s returned no executable.\n' "$ref" "$ref" > "$out/reference-${ref}-${dims/x/x}.txt"
    fi
  done
done

python3 "$here/lib/evidence_reports.py" "$product_root" "$out"
cp "$product_root/README.md" "$out/readme-walkthrough.txt"
cp "$product_root/skills/agent-deck/references/tui-reference.md" "$out/tui-reference.txt"
printf 'Injected scenario: tmux executable absent. Expected evidence must name tmux and give a concrete recovery command.\n' > "$out/missing-tmux-executable.txt"
printf 'Injected scenario: selected AI executable absent. Expected evidence must name that executable and give a concrete recovery command.\n' > "$out/missing-tool.txt"
printf 'Reduced-motion probe: Agent Deck exposes no animation preference in the captured UI or documented configuration. Static tmux capture records the stable rendered frame.\n' > "$out/reduced-motion.txt"
printf 'Screen-reader alternatives probe: inspect README and TUI reference for plain-language equivalents of status glyphs and keyboard actions.\n' > "$out/screen-reader-alternatives.txt"
printf '{"socket":"%s","fixture_root":"%s","sizes":["80x24","100x30","160x48"],"color_modes":["truecolor","ansi256","ansi16","no-color","ascii"],"product_version":"%s"}\n' \
  "$socket" "$root" "$(agent-deck --version 2>&1 | head -1)" > "$out/metadata.json"

case "$aspect" in
  onboarding)
    ;;
  recovery)
    cp "$out/preview-160x48.txt" "$out/error-preview-160x48.txt"
    cp "$out/preview-100x30.txt" "$out/error-preview-100x30.txt"
    printf 'Injected scenario: tmux executable absent. Judge recovery copy and concrete next command.\n' > "$out/missing-tmux-executable.txt"
    printf 'Injected scenario: selected AI executable absent. Judge recovery copy and concrete next command.\n' > "$out/missing-tool.txt"
    ;;
  remote-agents)
    HOME="$fixture" XDG_CONFIG_HOME= XDG_DATA_HOME= XDG_CACHE_HOME= agent-deck remote list > "$out/remote-list.txt" 2>&1 || true
    HOME="$fixture" XDG_CONFIG_HOME= XDG_DATA_HOME= XDG_CACHE_HOME= agent-deck agents > "$out/agents-cli.txt" 2>&1 || true
    ;;
esac
#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$here/aspects.sh"
lap="$(date -u +%F)"; aspect=""; score_only=0
while [ $# -gt 0 ]; do
  case "$1" in
    --date) lap="$2"; shift 2 ;;
    --aspect) aspect="$2"; shift 2 ;;
    --score-only) score_only=1; shift ;;
    *) lap="$1"; shift ;;
  esac
done
aspect="${aspect:-$(aspect_for_date "$lap")}"
aspect_screens "$aspect" >/dev/null
captures="$here/captures/$lap"
verdicts="$here/verdicts/$lap"
if [ "$score_only" = 0 ]; then
  # Station prompts are the immutable evidence contract for a lap. Updating
  # them is an explicit maintenance operation, never a capture side effect.
  if [ "${GAUNTLET_REFRESH_PROMPTS:-0}" = 1 ]; then
    python3 "$here/extract-prompts.py" "${GAUNTLET_PLAN:-/tmp/exec-gauntlet-build/gauntlet-uiux-plan.html}" "$here/prompts"
  fi
  "$here/collect-complaints.sh" "$here/complaints.md"
  "$here/capture.sh" "$captures" "$aspect"
  "$here/judge.sh" "$captures" "$verdicts" "$aspect"
fi
python3 "$here/score.py" "$here" "$lap" "$aspect"
echo "aspect: $aspect"
echo "captures: $captures"
echo "verdicts: $verdicts"
# Gauntlet satisfaction criteria

The Gauntlet rotates weekly through four aspects:

1. Core screens: first run, main list, New Session, help, and preview.
2. Onboarding and docs: first run, empty state, README walkthrough, New Session, attach/detach, and help.
3. Error states and recovery: missing tmux session, missing tmux executable, missing AI tool, and recovery actions.
4. Remote and agents: remote list/attach affordances, agents, and skills surfaces.

## Done rule

A screen is **DONE** only when all six judges explicitly PASS it at both 160x48 and 100x30 in two consecutive laps of that aspect. A missing capture, judge, size, or machine-readable verdict is a failure. A later failed lap breaks the streak.

An aspect is **DONE** only when every screen assigned to it is DONE. The product satisfaction bar is reached only when all four aspects are DONE.

`score.py` writes one comparable progress number after every lap:

`SATISFACTION_SCORE = DONE screens / 16 required screens × 100`

The score persists across the rotation in `scores/HISTORY.jsonl`; it never treats an untested week as a pass. Each lap also reports the raw judge-check pass rate for diagnosis, but that diagnostic rate is not the satisfaction score.


