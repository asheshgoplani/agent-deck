#!/usr/bin/env bash
set -euo pipefail
[ $# -eq 1 ] || { echo "usage: seed.sh HOME" >&2; exit 2; }
fixture_home="$1"
case "$fixture_home" in /tmp/*) ;; *) echo "fixture HOME must be under /tmp" >&2; exit 2;; esac
mkdir -p "$fixture_home" "$fixture_home/projects/api" "$fixture_home/projects/docs" "$fixture_home/projects/ops"
mkdir -p "$fixture_home/.config/agent-deck"
install -m 600 "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/config.toml" "$fixture_home/.config/agent-deck/config.toml"
export HOME="$fixture_home" XDG_CONFIG_HOME= XDG_DATA_HOME= XDG_CACHE_HOME=
agent-deck group create platform >/dev/null
agent-deck group create documentation >/dev/null
agent-deck add -t api-review -g platform "$fixture_home/projects/api" >/dev/null
agent-deck add -t release-notes -g documentation "$fixture_home/projects/docs" >/dev/null
agent-deck add -t incident-shell -g platform "$fixture_home/projects/ops" >/dev/null

