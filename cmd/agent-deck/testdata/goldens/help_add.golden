Usage: agent-deck add [path] [options]

Add a new session to Agent Deck.

Arguments:
  [path]    Project directory (default: group default_path, then global default_path,
            then the group's most recent session path, then current directory)

Options:

Examples:
  agent-deck add                       # Use current directory
  agent-deck add /path/to/project
  agent-deck add -t "My Project" -g "work"
  agent-deck add -c claude .
  agent-deck add -c codex --model gpt-5.5 .
  agent-deck add -c claude --model claude-opus-5 --effort high .
  agent-deck add -c claude --skip-permissions --chrome --continue .   # the dialog's Claude Options rows
  agent-deck add -c gemini --model gemini-3.1-pro-preview .
  agent-deck -p work add               # Add to 'work' profile
  agent-deck add -t "Sub-task" --parent "Main Project"  # Create sub-session
  agent-deck add -t "Research" -c claude --mcp memory --mcp sequential-thinking /tmp/x
  agent-deck add -c codex --mcp memory .  # writes to Codex config.toml
  agent-deck add -t "Bot" -c claude --channel plugin:telegram@user/repo .  # subscribe to plugin channel
  agent-deck add -c opencode --wrapper "nvim +'terminal {command}' +'startinsert'" .
  agent-deck add -c "codex --dangerously-bypass-approvals-and-sandbox" .
  agent-deck add -c gemini --yolo .
  agent-deck add -c claude -g work .   # -c is shorthand for --cmd
  agent-deck add -g ard --no-parent -c claude .
  agent-deck add --quick -c claude .   # Quick session; TUI shows Claude's live task description

Worktree Examples:
  agent-deck add -w feature/login .    # Create worktree for existing branch
  agent-deck add -w feature/new -b .   # Create worktree with new branch
  agent-deck add --worktree fix/bug-123 --new-branch /path/to/repo

SSH Examples:
  agent-deck add --ssh user@host --remote-path /home/user/project -c claude
  agent-deck add /home/user/project --ssh user@host -c claude   # positional path shortcut for --remote-path; must be absolute
  agent-deck add --ssh user@host -c claude -t "remote-dev"
