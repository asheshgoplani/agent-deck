  -default-path string
    	Default working directory for new sessions in this group
  -json
    	Output as JSON
  -max-concurrent int
    	Cap on simultaneous running sessions in this group (0=unlimited, 1=serial, N=cap; default: [group_defaults].max_concurrent, else 1) (default -1)
  -parent string
    	Create as subgroup under this parent
  -q	Minimal output (short)
  -quiet
    	Minimal output
