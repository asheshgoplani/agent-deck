# agent-deck fish completion
# Install: agent-deck completion fish > ~/.config/fish/completions/agent-deck.fish

function __agent_deck_toks
    set -l toks (commandline -opc)
    if [ (count $toks) -ge 3 ]; and contains -- $toks[2] -p --profile
        set toks $toks[1] $toks[4..-1]
    else if [ (count $toks) -ge 2 ]; and string match -q -- '-p=*' $toks[2]
        set toks $toks[1] $toks[3..-1]
    else if [ (count $toks) -ge 2 ]; and string match -q -- '--profile=*' $toks[2]
        set toks $toks[1] $toks[3..-1]
    end
    for t in $toks
        echo $t
    end
end

function __agent_deck_profile_arg
    set -l toks (commandline -opc)
    if [ (count $toks) -ge 3 ]; and contains -- $toks[2] -p --profile
        echo -p
        echo $toks[3]
    else if [ (count $toks) -ge 2 ]; and string match -q -- '-p=*' $toks[2]
        echo -p
        echo (string replace -r '^-p=' '' $toks[2])
    else if [ (count $toks) -ge 2 ]; and string match -q -- '--profile=*' $toks[2]
        echo -p
        echo (string replace -r '^--profile=' '' $toks[2])
    end
end

function __agent_deck_at
    set -l toks (__agent_deck_toks)
    if [ (count $toks) -ne $argv[3] ]
        return 1
    end
    if [ -n "$argv[1]" ]; and [ "$toks[2]" != "$argv[1]" ]
        return 1
    end
    if [ -n "$argv[2]" ]; and [ "$toks[3]" != "$argv[2]" ]
        return 1
    end
    return 0
end

# Profile name right after a leading -p/--profile.
complete -c agent-deck -f -n "test (count (commandline -opc)) -eq 2; and contains -- (commandline -opc)[2] -p --profile" -a "(agent-deck __complete profiles)"

# Top-level commands.
complete -c agent-deck -f -n "__agent_deck_at '' '' 1" -a "add list ls remove rm rename mv status update launch try accounts web debug-dump migrate-paths uninstall run-task feedback creds-refresh telegram-doctor version help completion profile inbox session fleet mcp plugin skill group conductor agents agent watcher openclaw oc remote worktree wt costs hooks codex-hooks gemini-hooks hermes-hooks cursor-hooks tmux-hooks pi-hooks deepseek"

# Subcommands.
